# Copier en .env à la racine du dépôt (jamais committé) — voir docs/setup.md

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=terraproxi
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Dev local (docker-compose.dev.yml expose la base sur localhost:5432, mot de passe devpassword)
DATABASE_URL=postgres://app_user:devpassword@localhost:5432/terraproxi
# Base dédiée aux tests d'intégration : elle est VIDÉE à chaque exécution de `pnpm test:api`
TEST_DATABASE_URL=postgres://app_user:devpassword@localhost:5432/terraproxi_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe (mode test : https://dashboard.stripe.com/test/apikeys) ───────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3002
NODE_ENV=development
# Production : origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=https://app.terraproxi.fr
# Mot de passe des comptes de démonstration créés par `pnpm db:seed`
SEED_PASSWORD=TerraProxi2026!

# ── Frontend web (figé dans le bundle au build) ───────────────────────────────
# Laisser vide en dev : le proxy Vite redirige /api vers l'API locale
VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# ── Gemini (Assistant IA) ─────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
