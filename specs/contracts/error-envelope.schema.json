{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "description": "Format de toutes les réponses d'erreur de l'API (apps/api/src/app.ts, onError).",
  "type": "object",
  "required": ["error", "status"],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1,
      "description": "Message lisible, en français, affichable tel quel"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599,
      "description": "Reprend le code HTTP de la réponse"
    },
    "details": {
      "type": "object",
      "description": "Présent seulement pour une erreur de validation (400) qui concerne un champ",
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "description": "Champ ou paramètre invalide (ex. password)" },
        "message": { "type": "string", "description": "Règle non respectée" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    { "error": "Données invalides", "status": 400, "details": { "field": "password", "message": "Expected string length greater or equal to 8" } },
    { "error": "Commande introuvable", "status": 404 },
    { "error": "Transition PENDING → PREPARING non autorisée", "status": 409 },
    { "error": "Erreur interne du serveur", "status": 500 }
  ]
}
