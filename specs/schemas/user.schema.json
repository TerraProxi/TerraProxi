{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.schema.json",
  "title": "User",
  "description": "Utilisateur tel que renvoyé par l'API (jamais de hash de mot de passe). Table users.",
  "type": "object",
  "required": ["id", "email", "first_name", "last_name", "role", "newsletter_opt_in", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email", "maxLength": 255, "description": "Toujours en minuscules" },
    "first_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "last_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "role": { "$ref": "#/$defs/UserRole" },
    "phone": { "type": ["string", "null"], "maxLength": 20 },
    "avatar_url": { "type": ["string", "null"], "maxLength": 500, "pattern": "^(https?://[^\\s<>\"]+)?$", "description": "URL http(s) uniquement (POST /uploads ou lien externe)" },
    "newsletter_opt_in": { "type": "boolean", "description": "Accepte les newsletters des producteurs chez qui il a commandé (opt-in, faux par défaut)" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "UserRole": {
      "type": "string",
      "enum": ["CONSUMER", "PRODUCER", "ADMIN"],
      "description": "ADMIN est réservé ; l'inscription ne propose que CONSUMER et PRODUCER"
    }
  }
}
