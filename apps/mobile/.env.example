# Variables de l'application mobile (copier en apps/mobile/.env)
# Téléphone physique : remplacer localhost par l'IP locale du PC (ex. 192.168.1.20)
EXPO_PUBLIC_API_URL=http://localhost:3002/api
# Clé publique Stripe (mode test). Le paiement natif demande un development build (pas Expo Go).
# Vide : l'écran de paiement indique que le paiement est indisponible.
EXPO_PUBLIC_STRIPE_KEY=pk_test_CHANGE_ME
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Lues par app.config.ts au moment du build (pas embarquées dans le JavaScript).
# Clé Google « Maps SDK for Android » : sans elle la carte est vide dans un build Android.
GOOGLE_MAPS_ANDROID_API_KEY=
# Identifiant du projet EAS affiché par `eas init` (voir docs/mobile-release.md).
EAS_PROJECT_ID=
