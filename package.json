{
  "name": "terraproxi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @terraproxi/api dev",
    "dev:web": "pnpm --filter @terraproxi/web dev",
    "dev:mobile": "pnpm --filter @terraproxi/mobile start",
    "build:api": "pnpm --filter @terraproxi/api build",
    "build:web": "pnpm --filter @terraproxi/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm spec:lint && pnpm -r lint",
    "test": "pnpm --filter @terraproxi/api test",
    "test:mobile": "pnpm --filter @terraproxi/mobile test",
    "db:migrate": "pnpm --filter @terraproxi/api db:migrate",
    "db:seed": "pnpm --filter @terraproxi/api db:seed",
    "spec:lint": "spectral lint \"specs/api/*.yaml\" --ruleset spectral.json --fail-severity error",
    "spec:check": "pnpm spec:lint && pnpm --filter @terraproxi/api test tests/conformance"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.6.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
